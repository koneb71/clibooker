{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clibooker",
  "version": "0.1.0",
  "identifier": "com.clibooker.app",
  "build": {
    "beforeDevCommand": "node scripts/prepare-sidecar.mjs debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-sidecar.mjs release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clibooker",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520
      },
      {
        "label": "palette",
        "title": "Clibooker Palette",
        "url": "index.html?window=palette",
        "width": 680,
        "height": 440,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Bookmark shell commands with their folder and Python env",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "externalBin": [
      "binaries/bk"
    ],
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "Clibooker"
}
